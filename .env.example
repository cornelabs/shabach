# ==============================================================================
# SHABACH 2026 Environment Configuration
# ==============================================================================

# Application Mode: 'demo' (in-browser sandbox) or 'live' (Supabase backend)
VITE_APP_MODE=demo

# Supabase Configuration (Required when VITE_APP_MODE=live)
# Replace with your actual Supabase project URL and anon public key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Used only in server-side administrative jobs / migrations)
# NEVER expose this key in client-side code or public repositories!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Voter Email OTP Verification Provider: 'mock' (in-memory dev) or 'resend' / 'sendgrid'
VOTER_EMAIL_PROVIDER=mock
RESEND_API_KEY=re_your_api_key_here
VOTER_FROM_EMAIL=voting@shabach.org

# Competition Timezone
TIMEZONE=Africa/Lagos

