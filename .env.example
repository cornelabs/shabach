# ==============================================================================
# SHABACH 2026 Grand Finale — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate the values for your project.
# NEVER commit production keys or service role secrets into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Project Credentials (Client-facing & SSR)
# ------------------------------------------------------------------------------
# Your Supabase Project reference ID (e.g. mmdwhtvpemktzncyjrjh)
SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"

# Your public API URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"

# Public anon / publishable key (safe for browser distribution under RLS)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder_key"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder_key"

# ------------------------------------------------------------------------------
# Supabase Service Role Key (Backend Server Functions ONLY)
# ------------------------------------------------------------------------------
# CAUTION: The service role key bypasses Row-Level Security (RLS).
# Keep strictly secret. Only configure in server environments (e.g. Cloudflare / Vercel secrets).
# Never expose in client bundles or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_placeholder_service_role_key"

# ------------------------------------------------------------------------------
# Application Environment Mode
# ------------------------------------------------------------------------------
# Options: 'development' | 'production' | 'test'
NODE_ENV="development"
